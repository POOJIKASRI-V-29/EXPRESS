# Copy to .env and fill in. NEVER commit real secrets.

# ─── Environment ──────────────────────────────────────────────────────────
# development | staging | production
# Anything other than "development" enables secure cookies and disables the
# verbose error detail returned to clients.
ENV=development
LOG_LEVEL=INFO

# ─── Host ports ───────────────────────────────────────────────────────────
# EXPRESS uses a dedicated 4310-4312 block so it never fights another local
# project for 3000/8000/5432. Change them here if you need to.
EXPRESS_WEB_PORT=4310
EXPRESS_API_PORT=4311
EXPRESS_DB_PORT=4312

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=express
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=express

# ─── Auth / crypto ────────────────────────────────────────────────────────
# REQUIRED. Generate with:  openssl rand -hex 32
# The app refuses to start in a non-development ENV without a real value.
SECRET_KEY=

# ─── URLs ─────────────────────────────────────────────────────────────────
# Must match EXPRESS_WEB_PORT — this is the CORS allow-list entry.
FRONTEND_ORIGIN=http://localhost:4310
# Must match EXPRESS_API_PORT — the browser calls the API directly.
NEXT_PUBLIC_API_URL=http://localhost:4311

# Time-of-day context for Home (morning/college/evening/night). Storage stays UTC.
LOCAL_TZ=Asia/Kolkata

# ─── Demo login seeded on first run ───────────────────────────────────────
DEMO_EMAIL=demo@express.os
DEMO_PASSWORD=expressdemo

# ─── JOCasta ──────────────────────────────────────────────────────────────
# ACTIVE PROVIDER: Google Gemini (Developer API).
#
# OPTIONAL. If GEMINI_API_KEY is set, JOCasta talks through the model — natural
# conversation, and function-calling for tool selection. If it is empty,
# JOCasta uses the deterministic rule planner and conversation templates: fully
# offline, no network, no degraded behaviour beyond less natural phrasing.
# Key at https://aistudio.google.com/apikey — server-side only, never exposed
# to the frontend.
GEMINI_API_KEY=
# Model ids get retired; this is a setting so a shut-down id is an env fix
# rather than a code change. Any current Flash-class model works.
GEMINI_MODEL=gemini-3.5-flash

# Previous provider. Unused while Gemini is active — kept so an existing .env
# still loads and the switch back needs no code change.
# NEVER commit a real key here; this file is a template.
ANTHROPIC_API_KEY=
JOCASTA_MODEL=claude-opus-5

# ─── Integrations (OPTIONAL) ──────────────────────────────────────────────
# A provider stays "unconfigured" and refuses to connect until its credentials
# are present here. Nothing is faked when these are blank.
OAUTH_REDIRECT_BASE=http://localhost:4311
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
